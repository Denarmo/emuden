{
  "comment": "The player's picture effects. A preset is a list of passes (a .glsl file of this folder each, see den/gfx/effect_chain.h); the last pass draws at the size the picture is shown at. 'params' are sliders, 'fixed' are values the user does not see; both are the uniforms p_<id>. 'integer' keeps the picture at whole multiples of its rows (true), or does when that loses little of the area (\"near\"). 'auto' names the preset a console gets when the choice is Auto.",
  "auto": {
    "gb": "dotmatrix",
    "gbc": "lcd",
    "gba": "lcd",
    "gg": "lcd",
    "nds": "sharp",
    "pico8": "pixel",
    "nes": "crt",
    "snes": "crt",
    "genesis": "crt",
    "sms": "crt",
    "psx": "crt",
    "saturn": "crt"
  },
