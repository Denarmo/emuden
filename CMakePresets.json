{
  "version": 6,
  "configurePresets": [
    {
      "name": "base", "hidden": true, "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "win", "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "linux", "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "android", "inherits": "base",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a", "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_shared", "DEN_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "win", "configurePreset": "win" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "android", "configurePreset": "android" }
  ]
}
